# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/barndo.db

# Generate with:  python -m app.crypto genkey
PII_ENCRYPTION_KEY=

# API key -> role (viewer | field | manager | admin). Use long random keys,
# e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS={"change-me-admin-key": "admin", "change-me-phone-key": "field"}

BUDGET_WARNING_PCT=85
BUDGET_CRITICAL_PCT=100

# local | gdrive | dropbox
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
GDRIVE_SERVICE_ACCOUNT_FILE=
GDRIVE_ROOT_FOLDER_ID=
DROPBOX_ACCESS_TOKEN=
DROPBOX_ROOT_PATH=/Killette Projects

# Sites allowed to call the API from a browser (the widget). JSON list.
CORS_ORIGINS=["https://barndobible.com", "https://www.barndobible.com"]

# ---- Website agent (barndobible.com) ----
# Your Claude Console API key. Server-side only: never put it in WordPress or the widget.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TOKENS=1200

# Knowledge base: pulled from the site's public WordPress API at startup and every 12 h.
KB_SOURCE_URL=https://barndobible.com
KB_CACHE_PATH=./data/kb.json
KB_REFRESH_HOURS=12
KB_SYNC_ON_STARTUP=true

# Cost / abuse guards: chat requests per visitor IP per window, and per day for everyone.
PUBLIC_RATE_LIMIT=15
PUBLIC_RATE_WINDOW_S=600
AGENT_DAILY_LIMIT=500
